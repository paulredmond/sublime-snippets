[
   // Move cursor to the EOL and add a semicolon.
   {
        "keys": ["super+shift+enter"],
        "command": "run_macro_file",
        "args": {
            "file": "Packages/User/sublime-snippets/macros/end-of-line-semicolon.sublime-macro"
        }
    },
    // Markdown comment override.
    {
        "keys": ["super+/"],
        "command": "insert_snippet",
        "args": {"contents": "[//]: # ($0)"},
        "context": [
            { "key": "selector", "operator": "equal", "operand": "text.html.markdown" }
        ]
    },
    // HTML comments in Markdown.
    {
        "keys": ["super+alt+/"],
        "command": "insert_snippet",
        "args": {"contents": "<!-- $0 -->"},
        "context": [
            { "key": "selector", "operator": "equal", "operand": "text.html.markdown" }
        ]
    },
    // Reveal current file in the sidebar.
    {
        "keys": ["ctrl+shift+r"],
        "command": "reveal_in_side_bar"
    },
    //
    // LSP Key bindings
    //

    // Goto Definition
    {
        "keys": ["super+b"],
        "command": "lsp_symbol_definition",
        "args": {"side_by_side": false, "force_group": true, "fallback": false, "group": -1},
        "context": [
            {"key": "lsp.session_with_capability", "operand": "definitionProvider"},
            {"key": "auto_complete_visible", "operand": false}
        ]
    },

    // Find References
    {
        "keys": ["super+shift+b"],
        "command": "lsp_symbol_references",
        "args": {"side_by_side": false, "force_group": true, "fallback": false, "group": -1, "include_declaration": false},
        "context": [{"key": "lsp.session_with_capability", "operand": "referencesProvider"}]
    },

    // Goto Definition (side-by-side)
    {
        "keys": ["super+shift+alt+b"],
        "command": "lsp_symbol_definition",
        "args": {"side_by_side": true, "force_group": true, "fallback": false, "group": -1},
        "context": [
            {"key": "lsp.session_with_capability", "operand": "definitionProvider"},
            {"key": "auto_complete_visible", "operand": false}
        ]
    },
]
